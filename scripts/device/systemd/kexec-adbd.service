[Unit]
Description=Kexec Ubuntu USB ADB
DefaultDependencies=no
After=local-fs.target kexec-vendor-mount.service
Before=multi-user.target
Wants=kexec-vendor-mount.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/kexec/bin/kexec-adbd
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
