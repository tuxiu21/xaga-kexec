[Unit]
Description=Kexec Ubuntu Wi-Fi bring-up
DefaultDependencies=no
After=local-fs.target kexec-vendor-mount.service kexec-adbd.service
Wants=kexec-vendor-mount.service

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'for _ in $(seq 1 90); do [ -e /lean/run/adbd.ready ] && exit 0; sleep 1; done; echo "kexec-wifi: timed out waiting for /lean/run/adbd.ready" >&2; exit 1'
ExecStart=/bin/bash /lean/ubuntu_phase_a_init.sh wifi
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
